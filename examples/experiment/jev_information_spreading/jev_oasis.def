Bootstrap: docker
From: nvidia/cuda:12.1.1-cudnn8-runtime-ubuntu22.04

# =============================================================================
# Apptainer image for the JEV "Information Spreading in X" reproduction.
#
# Contains: Python 3.11, PyTorch (CUDA 12.1), vLLM (OpenAI-compatible server),
# and the sentence-transformers / camel-ai stack OASIS needs.
#
# The repo is NOT baked into the image. The sbatch runner bind-mounts the
# working tree at /app (--pwd /app) at RUN time, so Python imports `oasis`
# straight from the mounted source. The image only provides the dependency
# environment. (This also avoids copying the host working tree, which can
# contain broken symlinks under docs/node_modules or .hermes_workspace that
# break `%files` with 'cannot stat'.)
#
# Build (no need to run from the repo root -- nothing is copied in):
#     apptainer build jev_oasis.sif jev_oasis.def
# =============================================================================

%post
    set -eux
    export DEBIAN_FRONTEND=noninteractive
    apt-get update
    apt-get install -y --no-install-recommends \
        software-properties-common ca-certificates git curl build-essential
    add-apt-repository -y ppa:deadsnakes/ppa
    apt-get update
    apt-get install -y --no-install-recommends \
        python3.11 python3.11-venv python3.11-dev
    rm -rf /var/lib/apt/lists/*

    # Isolated venv on Python 3.11 (repo requires >=3.10,<3.12).
    python3.11 -m venv /opt/venv
    . /opt/venv/bin/activate
    pip install --no-cache-dir --upgrade pip wheel setuptools

    # Torch (CUDA 12.1) + vLLM. Pin vLLM to a release that serves
    # /v1/completions with logit_bias (the JEV 1-token classifier path).
    pip install --no-cache-dir torch==2.3.1 --index-url https://download.pytorch.org/whl/cu121
    pip install --no-cache-dir vllm==0.5.0.post1

    # OASIS runtime deps (match pyproject pins). The repo code itself is
    # mounted at runtime, so only its dependencies are installed here.
    pip install --no-cache-dir \
        "camel-ai==0.2.90" \
        "sentence-transformers==3.0.0" \
        "pandas==2.2.2" \
        "huggingface_hub[cli]>=0.34" \
        httpx pyyaml colorama scikit-learn numpy

%environment
    export PATH=/opt/venv/bin:$PATH
    export PYTHONUNBUFFERED=1
    # Python finds `oasis` from the bind-mounted repo at /app (--pwd /app).
    export PYTHONPATH=/app:${PYTHONPATH:-}

%runscript
    exec python "$@"

%labels
    Purpose "JEV Information-Spreading reproduction (OASIS paper F.2.2)"
    Branch  "feat/jev-engine-core"
