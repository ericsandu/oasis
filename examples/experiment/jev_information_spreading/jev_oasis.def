Bootstrap: docker
From: vllm/vllm-openai:latest

# =============================================================================
# Apptainer image for the JEV "Information Spreading in X" reproduction.
#
# Built on the SAME proven base as the P0 oasis_base.sif (vllm/vllm-openai:latest)
# -- that image already ships vLLM + PyTorch + CUDA with a modern glibc, so it
# avoids the fakeroot/GLIBC build failure seen with the nvidia/cuda base and
# needs no hand-rolled torch/vLLM install.
#
# OASIS dependencies (incl. sentence-transformers, required for recommender
# parity) are installed from the repo's own pyproject.toml via Poetry, exactly
# as oasis_base.def does. Only pyproject.toml is copied in; the repo code is
# bind-mounted at /app by the sbatch runner at RUN time (so broken symlinks in
# the working tree never reach the build).
#
# Build (run from the repo root so %files finds pyproject.toml):
#     apptainer build \
#       examples/experiment/jev_information_spreading/jev_oasis.sif \
#       examples/experiment/jev_information_spreading/jev_oasis.def
# =============================================================================

%labels
    Maintainer CIB-Propagation Team
    Purpose    "JEV Information-Spreading reproduction (OASIS paper F.2.2)"
    Branch     "feat/jev-engine-core"

%files
    pyproject.toml /app/pyproject.toml

%environment
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8
    export PATH=/root/.local/bin:/usr/local/bin:$PATH
    export PYTHONPATH=/app:$PYTHONPATH
    export PIP_BREAK_SYSTEM_PACKAGES=1

%post
    export DEBIAN_FRONTEND=noninteractive
    export PIP_BREAK_SYSTEM_PACKAGES=1

    echo "Configuring JEV/OASIS container on top of official vLLM OpenAI image..."

    # 1. Essential system utilities (match oasis_base.def).
    apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        libcairo2-dev \
        pkg-config \
        python3-dev \
        wget \
        unzip \
        curl \
        git \
        jq \
        ripgrep \
        && rm -rf /var/lib/apt/lists/*

    # 2. Astral uv for fast deterministic environment management.
    curl -LsSf https://astral.sh/uv/install.sh | sh
    export PATH="/root/.local/bin:$PATH"

    # 3. Install Poetry and OASIS dependencies from pyproject.toml WITHOUT
    #    touching the pre-compiled vLLM / PyTorch already in the base image.
    #    This brings in sentence-transformers / sklearn / camel-ai etc. per the
    #    repo's own pins -- required for faithful recommender parity.
    echo "Installing Poetry and OASIS dependencies..."
    uv pip install --system poetry
    cd /app
    poetry config virtualenvs.create false
    poetry install --no-root --no-interaction --no-ansi

    # 4. huggingface_hub CLI (`hf`) for first-run model download into ~/models.
    uv pip install --system "huggingface_hub[cli]>=0.34"

    # 5. Container mount points (repo + models + outputs bound at run time).
    mkdir -p /app /models /data /experiments /workspace

%runscript
    exec "$@"
