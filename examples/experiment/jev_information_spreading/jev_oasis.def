Bootstrap: docker
From: nvidia/cuda:13.4.2-cudnn-runtime-ubuntu24.04

# =============================================================================
# Minimal Apptainer image for the JEV / OASIS Information-Spreading reproduction.
#
# Grounded in OASIS's own documented requirements:
#   * Python >=3.10,<3.12            (pyproject requires-python)
#   * OASIS via pip (`pip install -e .`)   (docs/quickstart.mdx)
#   * vLLM installed SEPARATELY as the model server  (docs: "Set up VLLM")
#   * huggingface_hub for model download             (docs)
#
# CUDA 13 base matches the cluster's upgraded driver (590.48.01 / CUDA 13.1);
# the old vllm/vllm-openai (cu121) SIF fails there with "No CUDA GPUs available".
# vLLM 0.23.0 pins torch 2.11.0 (CUDA-13 build) to match the driver.
#
# Ubuntu 24.04 base (glibc 2.39) so apptainer's fakeroot `faked` -- which needs
# GLIBC_2.38 -- works; a 22.04 base (glibc 2.35) fails the build at fakeroot.
# 24.04 ships Python 3.12, which violates OASIS's requires-python <3.12, so we
# install deadsnakes Python 3.11 into a venv: 24.04 for fakeroot safety, 3.11
# for OASIS compatibility.
#
# Only pyproject.toml is copied in (OASIS code is bind-mounted at /app at run
# time), so the build never touches the working tree's broken symlinks.
#
# Build from the repo root:
#   srun --partition=haswell --cpus-per-task=32 --mem=32GB apptainer build \
#     examples/experiment/jev_information_spreading/jev_oasis.sif \
#     examples/experiment/jev_information_spreading/jev_oasis.def
# =============================================================================

%labels
    Purpose "JEV / OASIS Information-Spreading reproduction (CUDA 13, py3.11)"
    Branch  "feat/jev-engine-core"

%files
    pyproject.toml /app/pyproject.toml

%environment
    export PATH=/opt/venv/bin:$PATH
    export PYTHONPATH=/app:$PYTHONPATH
    export PYTHONUNBUFFERED=1
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8

%post
    set -eux
    export DEBIAN_FRONTEND=noninteractive

    # Python 3.11 (OASIS requires >=3.10,<3.12; Ubuntu 22.04 ships 3.10, but
    # deadsnakes 3.11 is the safe pin) + minimal build/runtime tools.
    apt-get update
    apt-get install -y --no-install-recommends \
        software-properties-common ca-certificates curl git \
        build-essential pkg-config libcairo2-dev
    add-apt-repository -y ppa:deadsnakes/ppa
    apt-get update
    apt-get install -y --no-install-recommends \
        python3.11 python3.11-venv python3.11-dev
    rm -rf /var/lib/apt/lists/*

    # Isolated venv on 3.11.
    python3.11 -m venv /opt/venv
    . /opt/venv/bin/activate
    pip install --no-cache-dir --upgrade pip setuptools wheel

    # vLLM pinned to 0.23.0: the LAST vLLM that supports transformers v4
    # (>=4.56,!=5.*). vLLM 0.24+ requires transformers v5, but OASIS's
    # camel-ai 0.2.90 and sentence-transformers 3.0.0 both require
    # transformers <5 -- an irreconcilable conflict at latest vLLM. 0.23.0
    # pins torch 2.11.0 (CUDA-13 build) so the GPU still works on driver 590.
    pip install --no-cache-dir "vllm==0.23.0" "huggingface_hub[cli]"

    # OASIS dependencies from its pyproject (sentence-transformers, camel-ai,
    # pandas, igraph, ... -- needed for the recommender + agents). Install the
    # pinned deps without the project root; the code is bind-mounted at run time.
    pip install --no-cache-dir \
        "camel-ai==0.2.90" \
        "sentence-transformers==3.0.0" \
        "pandas==2.2.2" \
        "igraph==0.11.6" \
        "cairocffi==1.7.1" \
        "pillow==10.3.0" \
        "scikit-learn" "numpy" "httpx" "pyyaml" "colorama"

    mkdir -p /app /models /data /experiments

%runscript
    exec "$@"
