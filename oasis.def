Bootstrap: docker
From: vllm/vllm-openai:latest

%labels
    Maintainer CAMEL-AI & CIB-Propagation Team
    Version 1.2.0
    Description OASIS Simulation Container (vLLM, PyTorch, CUDA, Gorse, Poetry)

%files
    pyproject.toml /app/pyproject.toml

%environment
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8
    export PATH=/root/.local/bin:/usr/local/bin:$PATH
    export PYTHONPATH=/app:$PYTHONPATH
    export PIP_BREAK_SYSTEM_PACKAGES=1

%post
    export DEBIAN_FRONTEND=noninteractive
    export PIP_BREAK_SYSTEM_PACKAGES=1

    echo "Configuring OASIS container on top of official vLLM OpenAI image..."

    # 1. Essential system utilities
    apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        libcairo2-dev \
        pkg-config \
        python3-dev \
        wget \
        unzip \
        curl \
        git \
        jq \
        ripgrep \
        && rm -rf /var/lib/apt/lists/*

    # 2. Install Astral uv for fast deterministic environment management
    curl -LsSf https://astral.sh/uv/install.sh | sh
    export PATH="/root/.local/bin:$PATH"

    # 3. Install Gorse binary
    echo "Installing Gorse binary..."
    wget -q https://github.com/gorse-io/gorse/releases/download/v0.5.11/gorse_linux_amd64.zip
    unzip gorse_linux_amd64.zip -d /tmp/gorse
    mv /tmp/gorse/gorse-in-one /usr/local/bin/
    chmod +x /usr/local/bin/gorse-in-one
    rm -rf /tmp/gorse gorse_linux_amd64.zip

    # 4. Install Poetry and OASIS dependencies without touching pre-compiled vLLM / PyTorch
    echo "Installing Poetry and OASIS dependencies..."
    uv pip install --system poetry
    cd /app
    poetry config virtualenvs.create false
    poetry install --no-root --no-interaction --no-ansi

    # 5. Create container mount points
    mkdir -p /app /models /data /experiments /workspace

%runscript
    exec "$@"
